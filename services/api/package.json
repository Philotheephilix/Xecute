{
  "name": "@floors/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "test": "node node_modules/vitest/vitest.mjs run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "generate:openapi": "node dist/openapi.js > openapi.json"
  },
  "dependencies": {
    "@floors/shared-server": "workspace:*",
    "@floors/types": "workspace:*",
    "fastify": "5.3.3",
    "postgres": "3.4.5",
    "zod": "3.25.67",
    "zod-to-json-schema": "3.24.5"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/node": "22.15.3",
    "vitest": "3.2.4"
  }
}
