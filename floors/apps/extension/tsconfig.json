{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "outDir": "dist",
    "rootDir": ".",
    "types": ["chrome"]
  },
  "include": ["src/**/*", "wxt.config.ts", "e2e/**/*"],
  "exclude": ["node_modules", "dist", ".output"]
}
